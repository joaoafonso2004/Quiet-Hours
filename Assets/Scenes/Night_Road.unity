--- !u!114 &1067260321
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1067260319}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e919516e398ed74092c4b52a985f0e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue: {fileID: 0}
  speakerName: Stranger
  lines:
  - Saw your lights stop. Car trouble?
  - I am just up the road myself. Give you a hand if you want.
  - These roads eat alternators. That what you were down there for?
  - The industrial park, right. The one past the water tower.
  - You left about ten. Half ten.
  - "No \u2014 quarter to. It was quarter to."
  - Long way to come on your own.
  offerLines:
  - Those boxes are heavy on your own. Pop the boot, I will put them across for you.
  - Right. Where am I taking them?
  playerAnswer: Fourteen, off the square. Third floor.
  closingLine: I know the one. The street door downstairs does not lock.
  playerName: Tomas
  holdSeconds: 3.4
  gapSeconds: 1.1
  answerDelaySeconds: 4.5
  strangerVoice: {fileID: 1383025997}
  playerVoice: {fileID: 1329070364}
  seat: {fileID: 0}
  director: {fileID: 0}
  helpedEvent: stranger_helped
  refusedEvent: stranger_refused
