  title: Day 3 - Limits
  cardDate: WEDNESDAY
  cardTime: 08:14
  startsOnEvent: day_two
  steps:
  - Objective: 'OBJECTIVE: Check the apartment.'
    SideObjective: 
    Thought: Rui is never out this early. His bed has not been touched.
    Ends: 2
    Seconds: 5
    Place: {x: -1.75, y: 0, z: -2.95}
    Radius: 2.2
    EventId: 
    RaiseOnComplete:
    - day3_searched
  - Objective: 'OBJECTIVE: Do two things while the flat is empty.'
    SideObjective: Choose from food, laundry, washing up, the table or the spilled wine
    Thought: The flat is mine until one o'clock. That has not happened yet.
    Ends: 3
    Seconds: 5
    Place: {x: 0, y: 0, z: 0}
    Radius: 2
    EventId: day3_chores
    RaiseOnComplete: []
  - Objective: 'OBJECTIVE: Finish the morning''s work.'
    SideObjective: Use the laptop at your desk
    Thought: One quiet hour. Use it while the flat is still empty.
    Ends: 3
    Seconds: 5
    Place: {x: 0, y: 0, z: 0}
    Radius: 2
    EventId: day3_ready
    RaiseOnComplete:
    - seller_confirms
  - Objective: 'OBJECTIVE: Go to your room and lock the door.'
    SideObjective: Rui has come back
    Thought: He came in without calling out.
    Ends: 3
    Seconds: 5
