    Ends: 3
    Seconds: 5
    Place: {x: 0, y: 0, z: 0}
    Radius: 2
    EventId: clothes_ready
    RaiseOnComplete: []
  - Objective: 'OBJECTIVE: Put the kitchen things on the worktop.'
