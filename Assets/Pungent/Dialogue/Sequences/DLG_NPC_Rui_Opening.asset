  m_Script: {fileID: 11500000, guid: fb96658ea9497e745bd8953c2f5e1176, type: 3}
  m_Name: DLG_NPC_Rui_Opening
  m_EditorClassIdentifier: 
  speaker: Rui
  beats:
  - Line: It came back. I saw the light on the box turn green from here.
    Choices:
    - Text: Took a minute. It is an old thing.
      Reply: Everything in here is old. Thanks for getting up.
      Tone: 0
    - Text: It was ten steps. You could have gone yourself.
      Reply: I could have. You were already awake, though.
      Tone: 1
    - Text: Say nothing
      Reply: "\u2026Right."
      Tone: 4
  - Line: Your car is the black one, right? The old sedan under the window.
    Choices:
    - Text: It is. It needs a lot of work.
      Reply: There is a man near the industrial park who sells parts cheap. I can
        send you the number.
      Tone: 0
    - Text: How do you know which one is mine?
      Reply: You park it in the same spot every night. Hard to miss.
      Tone: 1
    - Text: Say nothing
      Reply: "\u2026Sure."
      Tone: 4
  - Line: Get some sleep. You have got that early class.
    Choices: []
  choiceSeconds: 9
  lineHold: 2.6
