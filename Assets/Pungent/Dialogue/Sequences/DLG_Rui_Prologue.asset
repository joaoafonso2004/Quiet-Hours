%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb96658ea9497e745bd8953c2f5e1176, type: 3}
  m_Name: DLG_Rui_Prologue
  m_EditorClassIdentifier: 
  speaker: Rui
  beats:
  - Line: "Tom\xE1s, right? I'm Rui \u2014 I have the other room. Welcome. Here,
      spare key. The lock sticks if you rush it."
    UsePhone: 0
    Choices:
    - Text: Thanks. Good to meet you.
      Reply: You too. It is quiet here, mostly. Just us two on this floor.
      Tone: 0
      RaisesEvent: 
    - Text: There is only one spare?
      Reply: There is only one of me.
      Tone: 1
      RaisesEvent: 
    - Text: Say nothing
      Reply: "\u2026Right. It is on the hook by the door if you want it."
      Tone: 4
      RaisesEvent: 
  - Line: What time do you head out in the mornings? So I know not to use the shower.
    UsePhone: 0
    Choices:
    - Text: Early. Tuesdays especially.
      Reply: Tuesdays. Noted.
      Tone: 2
      RaisesEvent: 
    - Text: It changes. Depends on the week.
      Reply: Sure. I will work it out.
      Tone: 3
      RaisesEvent: 
    - Text: Say nothing
      Reply: "\u2026No problem. I will just listen for the door."
      Tone: 4
      RaisesEvent: 
  - Line: Put your number in mine, in case the boiler goes while you are out. I will
      text you so you have got mine.
    UsePhone: 1
    Choices:
    - Text: Sure. Here.
      Reply: "Saved. Tom\xE1s with the accent on the a, right? Good."
      Tone: 0
      RaisesEvent: 
    - Text: You can just knock.
      Reply: I will text you anyway. Easier if something happens while you are out.
      Tone: 3
      RaisesEvent: 
    - Text: Say nothing
      Reply: I will text you. Then you have got it either way.
      Tone: 4
      RaisesEvent: 
  - Line: Your room is the last door on the left. Take the keys from the stand by
      the entrance before you go in.
    UsePhone: 0
    Choices: []
  choiceSeconds: 0
  lineHold: 2.6
