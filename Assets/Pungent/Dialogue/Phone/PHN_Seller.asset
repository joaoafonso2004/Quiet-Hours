  steps:
  - Line: Morning. Still want the alternator and the front discs?
    DelaySeconds: 26
    WaitForEvent: day_two
    StaleAfterEvent: 
    TypingSeconds: 4
    Choices:
    - Text: Yes. Today still works?
      Reply: Today works. Cash, like we said.
      Tone: 0
      RaisesEvent: 
    - Text: Remind me what you want for them.
      Reply: Ninety for both. That is half what the shop wanted, so do not push it.
      Tone: 2
      RaisesEvent: 
    ReplyDelaySeconds: 30
    EndsThread: 0
  - Line: I am up your way this evening. I will leave them inside the street door,
      third floor landing.
    DelaySeconds: 30
    WaitForEvent: 
    StaleAfterEvent: 
    TypingSeconds: 4
    Choices:
    - Text: Fine. I will be in.
      Reply: You do not need to be. Cash under the mat is fine by me.
      Tone: 0
      RaisesEvent: 
    - Text: I never told you which floor.
      Reply: Did you not? Someone did.
      Tone: 1
      RaisesEvent: 
    ReplyDelaySeconds: 26
    EndsThread: 0
  - Line: Left it on your landing. Do not leave it out there all night, that building
      is not as locked as you think.
    DelaySeconds: 18
    WaitForEvent: day3_ready
    StaleAfterEvent: 
    TypingSeconds: 4
